# ClaimSleuth Environment Configuration Example
# Copy this file to .env and populate with your credentials if using LLM reasoning.

# Google Gemini API Key (optional - system falls back gracefully to deterministic rules if unset)
GOOGLE_API_KEY=your-gemini-api-key-here

# Enable LLM Reasoning Engine (set to 'true' to use Gemini, 'false' for deterministic mode)
USE_LLM=false

# Gemini Model Selection (default: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Adjudication Endpoint Authorization Token (optional - leave empty for local demo mode)
CLAIMSLEUTH_ADJUDICATION_TOKEN=
